<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TextbookStoreApp">

        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.RegisterActivity"
            android:label="Register" />

        <activity
            android:name=".activities.HomeActivity"
            android:label="Home" />

        <activity
            android:name=".activities.SearchActivity"
            android:label="Search Books" />

        <activity
            android:name=".activities.DetailActivity"
            android:label="Book Details" />

        <activity
            android:name=".activities.ListBookActivity"
            android:label="List Your Book" />

        <activity
            android:name=".activities.EnquiryActivity"
            android:label="Contact Seller" />

        <activity
            android:name=".activities.MessagesActivity"
            android:label="Messages" />

    </application>

</manifest>