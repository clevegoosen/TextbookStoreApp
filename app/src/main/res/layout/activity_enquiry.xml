<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/background_cream">

        <TextView
            android:id="@+id/tvEnquiryHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enquiry for:"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/african_ochre"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etUserMessage"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:hint="Type your message to the seller..."
            android:gravity="top"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnSendMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send Message"
            android:backgroundTint="@color/african_ochre"
            android:textColor="@android:color/white"
            android:padding="12dp"/>

    </LinearLayout>
</layout>